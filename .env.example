# Copy to .env and fill in. Everything the app needs lives in this one file;
# the frontend has no environment file of its own.
#
#   docker compose up -d --build
#   cd frontend-web && npm run dev      ->  http://localhost:5173

# Which services start:
#   local   Postgres container + Mailpit mail catcher + backend + AI
#   prod    backend + AI + nginx frontend (managed database, real SMTP)
#   empty   backend + AI only (managed database and real SMTP, dev frontend)
# Image tag to run. 'latest' follows main; set a commit SHA to roll back.
IMAGE_TAG=latest

COMPOSE_PROFILES=local

# --- Database ---------------------------------------------------------------
# Keep credentials in DB_USERNAME/DB_PASSWORD, not as URL query parameters,
# so there is a single source of truth for them.
#
# Local container:
DB_URL=jdbc:postgresql://db:5432/cultivation
DB_USERNAME=postgres
DB_PASSWORD=postgres
#
# Managed (Neon, Supabase, RDS):
# DB_URL=jdbc:postgresql://<host>/<database>?sslmode=require
# DB_USERNAME=<user>
# DB_PASSWORD=<password>

# Only used by the `local` profile. Kept separate from DB_USERNAME/DB_PASSWORD
# so pointing the app at a managed database does not reconfigure this container.
POSTGRES_DB=cultivation
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Must match the major version of the managed database. Changing it needs a
# fresh volume: Postgres will not start on a directory from another version.
POSTGRES_VERSION=16
# Host port for pgAdmin/DBeaver. 5432 is often taken by a local install.
DB_PORT=5434

# --- Security ---------------------------------------------------------------
# At least 32 characters. The app refuses to start without it.
JWT_SECRET=replace_with_a_long_random_secret_min_32_chars
# 0.0.0.0 locally; 127.0.0.1 in production so nginx is the only public entry.
HOST_BIND=0.0.0.0
# Publishes the full API map - development only.
SWAGGER_ENABLED=true
# Per-IP limits on /api/auth/**. Leave on.
RATE_LIMIT_ENABLED=true
# Browser origins allowed to call the AI service directly. Empty is correct:
# only the backend calls it, server to server.
AI_ALLOWED_ORIGINS=

# --- Email ------------------------------------------------------------------
# Local: Mailpit catches everything at http://localhost:8025, no account needed.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=AgroMaster <no-reply@agromaster.local>
#
# Gmail: MAIL_PASSWORD must be a Google App Password (16 characters, no
# spaces) from myaccount.google.com/apppasswords, with 2-Step Verification on.
# It is not the account password.
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_SMTP_AUTH=true
# MAIL_STARTTLS=true
# MAIL_USERNAME=you@gmail.com
# MAIL_PASSWORD=xxxxxxxxxxxxxxxx
# MAIL_FROM=AgroMaster <you@gmail.com>

# --- AI advisor -------------------------------------------------------------
# Any OpenAI-compatible chat completions endpoint.
#   Groq        https://api.groq.com/openai/v1                           openai/gpt-oss-120b
#   Gemini      https://generativelanguage.googleapis.com/v1beta/openai/ gemini-3.6-flash
#   OpenAI      https://api.openai.com/v1                                gpt-4o-mini
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b

# --- Google Sign-In ---------------------------------------------------------
# OAuth 2.0 Web client ID from console.cloud.google.com. Blank hides the button.
GOOGLE_CLIENT_ID=

# --- Weather ----------------------------------------------------------------
OPENWEATHER_API_KEY=

# --- Misc -------------------------------------------------------------------
# Reminders are stored without a zone; a UTC container fires 07:00 at 01:30.
TZ=Asia/Colombo
# Domain nginx serves and finds TLS certificates under. Prod profile only.
DOMAIN=localhost
# Where certbot writes ACME challenges; nginx serves them from the same path.
# CERTBOT_WEBROOT=/var/www/certbot

# --- Optional ---------------------------------------------------------------
# LOG_LEVEL=DEBUG
# SHOW_SQL=true
# AI_MAX_TOKENS=4096
# AI_REASONING_EFFORT=low
# REMINDER_CRON=0 0 7 * * *
# REMINDER_LEAD_DAYS=2,1
# REMINDER_EMAIL_ENABLED=true
