# Copy this file to .env and adjust.
# COMPOSE_PROFILES decides which services start, so the command is always:
#   docker compose up -d --build

# ---------------------------------------------------------------------------
# LOCAL DEVELOPMENT  (default — runs Postgres in a container)
# ---------------------------------------------------------------------------
COMPOSE_PROFILES=local

# Host "db" is the compose service name, reached over the compose network.
DB_URL=jdbc:postgresql://db:5432/cultivation
DB_USERNAME=postgres
DB_PASSWORD=postgres
POSTGRES_DB=cultivation

# Windows-side port for pgAdmin/DBeaver. 5432 and 5433 are often already
# taken by a locally installed PostgreSQL, so the container uses 5434.
DB_PORT=5434

# Must be at least 32 characters.
JWT_SECRET=replace_with_a_long_random_secret_min_32_chars

# Optional. Without these the AI Advisor and weather widgets fail;
# crops, expenses, harvests and analytics work regardless.
GROQ_API_KEY=
OPENWEATHER_API_KEY=
OPENWEATHER_BASE_URL=https://api.openweathermap.org

# ---------------------------------------------------------------------------
# PRODUCTION  (uncomment these and comment out the local block above)
# ---------------------------------------------------------------------------
# The db container is not started under this profile — point DB_URL at a
# managed Postgres (Neon, Supabase, RDS...).
#
# COMPOSE_PROFILES=prod
# DB_URL=jdbc:postgresql://<host>/<database>?sslmode=require
# DB_USERNAME=<user>
# DB_PASSWORD=<password>
# JWT_SECRET=<long random secret>
# GROQ_API_KEY=<key>
# OPENWEATHER_API_KEY=<key>

# --- Email -----------------------------------------------------------------
# Local: Mailpit catches everything, read it at http://localhost:8025
# Production (Brevo): MAIL_HOST=smtp-relay.brevo.com MAIL_PORT=587
#                     MAIL_SMTP_AUTH=true MAIL_STARTTLS=true
#                     MAIL_USERNAME / MAIL_PASSWORD from your Brevo SMTP keys
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=AgroMaster <no-reply@agromaster.local>

# Reminder scheduling and email timestamps.
TZ=Asia/Colombo
