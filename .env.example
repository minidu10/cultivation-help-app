# Copy this file to .env and adjust.
# COMPOSE_PROFILES decides which services start, so the command is always:
#   docker compose up -d --build

# ---------------------------------------------------------------------------
# LOCAL DEVELOPMENT  (default — runs Postgres in a container)
# ---------------------------------------------------------------------------
COMPOSE_PROFILES=local

# Host "db" is the compose service name, reached over the compose network.
DB_URL=jdbc:postgresql://db:5432/cultivation
DB_USERNAME=postgres
DB_PASSWORD=postgres
POSTGRES_DB=cultivation

# Windows-side port for pgAdmin/DBeaver. 5432 and 5433 are often already
# taken by a locally installed PostgreSQL, so the container uses 5434.
DB_PORT=5434

# Must be at least 32 characters.
JWT_SECRET=replace_with_a_long_random_secret_min_32_chars

# Optional. Without these the AI Advisor and weather widgets fail;
# crops, expenses, harvests and analytics work regardless.
OPENWEATHER_API_KEY=
OPENWEATHER_BASE_URL=https://api.openweathermap.org

# ---------------------------------------------------------------------------
# PRODUCTION  (uncomment these and comment out the local block above)
# ---------------------------------------------------------------------------
# The db container is not started under this profile — point DB_URL at a
# managed Postgres (Neon, Supabase, RDS...).
#
# COMPOSE_PROFILES=prod
# DB_URL=jdbc:postgresql://<host>/<database>?sslmode=require
# DB_USERNAME=<user>
# DB_PASSWORD=<password>
# JWT_SECRET=<long random secret>
# OPENWEATHER_API_KEY=<key>

# --- Email -----------------------------------------------------------------
# Local: Mailpit catches everything, read it at http://localhost:8025
# Production (Brevo): MAIL_HOST=smtp-relay.brevo.com MAIL_PORT=587
#                     MAIL_SMTP_AUTH=true MAIL_STARTTLS=true
#                     MAIL_USERNAME / MAIL_PASSWORD from your Brevo SMTP keys
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=AgroMaster <agromaster2026@gmail.com>

# To send through the real Gmail account instead of Mailpit, swap these in.
# MAIL_PASSWORD must be a Google App Password (16 characters, no spaces),
# NOT the account password - generate one at myaccount.google.com/apppasswords
# after turning on 2-Step Verification.
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_SMTP_AUTH=true
# MAIL_STARTTLS=true
# MAIL_USERNAME=agromaster2026@gmail.com
# MAIL_PASSWORD=xxxxxxxxxxxxxxxx

# Reminder scheduling and email timestamps.
TZ=Asia/Colombo

# --- Google Sign-In ---------------------------------------------------------
# OAuth 2.0 Web client ID from console.cloud.google.com.
# Leave blank to hide the Google button entirely.
GOOGLE_CLIENT_ID=

# --- AI advisor -------------------------------------------------------------
# Any OpenAI-compatible chat completions endpoint. Set these three and the
# provider is whatever you point them at.
#   Gemini      https://generativelanguage.googleapis.com/v1beta/openai/  gemini-3.6-flash
#   Groq        https://api.groq.com/openai/v1                            llama-3.3-70b-versatile
#   OpenRouter  https://openrouter.ai/api/v1                              meta-llama/llama-3.3-70b-instruct
#   OpenAI      https://api.openai.com/v1                                 gpt-4o-mini
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-3.6-flash

# Ceiling, not a reservation - you are billed for tokens actually produced.
# Reasoning models spend part of it on hidden thinking, so a low ceiling
# truncates the visible answer. Brevity is enforced by the system prompt.
AI_MAX_TOKENS=4096
# Trims the hidden thinking budget. Blank omits the parameter for providers
# that do not support it (Groq, OpenAI, Ollama).
AI_REASONING_EFFORT=low

# --- Diagnostics ------------------------------------------------------------
# LOG_LEVEL=DEBUG and SHOW_SQL=true while debugging; both are off by default
# because pretty-printing every SQL statement is expensive and noisy.
LOG_LEVEL=INFO
SHOW_SQL=false

# --- Security ---------------------------------------------------------------
# 0.0.0.0 publishes the API and AI ports on all interfaces (fine locally).
# Set to 127.0.0.1 in production so only nginx can reach them.
HOST_BIND=0.0.0.0
# Swagger hands out the full API map - development only.
SWAGGER_ENABLED=true
# Per-IP limits on the auth endpoints. Leave on.
RATE_LIMIT_ENABLED=true
# Browser origins allowed to call the AI service directly. Empty is correct:
# only the backend calls it, server to server.
AI_ALLOWED_ORIGINS=
#
# PRODUCTION security settings:
#   HOST_BIND=127.0.0.1
#   SWAGGER_ENABLED=false
#   RATE_LIMIT_ENABLED=true
#   AI_ALLOWED_ORIGINS=
