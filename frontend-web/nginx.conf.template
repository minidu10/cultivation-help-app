# Rendered at container start by the nginx image's envsubst, which substitutes
# ${DOMAIN} from the environment. NGINX_ENVSUBST_FILTER=DOMAIN is set in the
# Dockerfile so nginx's own $host, $uri and $upstream are left untouched.

server {
    listen 80;
    server_name ${DOMAIN} www.${DOMAIN};

    # Certbot renewal reaches this over plain HTTP, so it must not be redirected.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN} www.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    root /usr/share/nginx/html;
    index index.html;

    # Do not advertise the nginx version.
    server_tokens off;

    # ---- Compression -------------------------------------------------------
    # Without this the SPA bundle ships uncompressed: roughly 213 KB instead of
    # 65 KB, which matters on the rural connections this app is built for.
    gzip on;
    gzip_vary on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        application/manifest+json
        image/svg+xml;

    # ---- Security headers --------------------------------------------------
    include /etc/nginx/security-headers.conf;

    resolver 127.0.0.11 valid=10s;

    # ---- Static assets -----------------------------------------------------
    # Vite fingerprints these filenames, so a changed file is a changed URL and
    # the cached copy can never be stale.
    location /assets/ {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location / {
        # The entry point must never be cached, or a deploy is invisible until
        # the browser decides to revalidate.
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }

    location /api {
        set $upstream http://backend:8080;
        proxy_pass $upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # AI answers can take a while; the default 60s cuts them off.
        proxy_read_timeout 120s;
        proxy_connect_timeout 10s;
    }
}
