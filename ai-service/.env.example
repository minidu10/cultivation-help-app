# AI advisor - any OpenAI-compatible chat completions endpoint.
# Set these three and the provider is whatever you point them at.

AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-3.6-flash

# Other providers, same three variables:
#   Groq        https://api.groq.com/openai/v1          llama-3.3-70b-versatile
#   OpenRouter  https://openrouter.ai/api/v1            meta-llama/llama-3.3-70b-instruct
#   OpenAI      https://api.openai.com/v1               gpt-4o-mini
#   Ollama      http://host.docker.internal:11434/v1    llama3
